FROM node:20-alpine

WORKDIR /app

# Copy root package.json and service package.jsons for workspace install
COPY package*.json ./
COPY frontend/package.json ./frontend/
COPY backend/package.json ./backend/
COPY shared/package.json ./shared/

RUN npm install

COPY . .

WORKDIR /app/shared
RUN npm run build

WORKDIR /app/backend
RUN npm run build

EXPOSE 4000
CMD ["npm", "start"]
