# Motion Service Environment Configuration

# Redis Connection
REDIS_URL="redis://localhost:6379"

# Google Cloud Storage
GCS_PROJECT_ID="your-gcp-project-id"
GCS_BUCKET_NAME="athleteiq-videos"

# GCS Credentials (optional - will use Application Default Credentials if not set)
# Format: Full JSON service account key as string
# Generate: gcloud iam service-accounts keys create --iam-account=...
GOOGLE_CLOUD_CREDENTIALS='{"type":"service_account","project_id":"..."}'

# Backend Communication
BACKEND_URL="http://localhost:4000"

# Internal Service Authentication Token
# Must match the INTERNAL_SERVICE_TOKEN in backend .env
# Generate secure token: openssl rand -base64 32
INTERNAL_SERVICE_TOKEN="super-secret-internal-service-token"

# Logging
LOG_LEVEL="INFO"

# FFmpeg Configuration (optional tuning)
# FFMPEG_FPS="1"           # Frames per second to extract (default: 1)
# FFMPEG_QUALITY="3"       # JPEG quality 1-31, lower = better (default: 3)
