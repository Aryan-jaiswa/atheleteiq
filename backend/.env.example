# Database Configuration
# PostgreSQL connection string for AthleteIQ
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL="postgresql://athleteiq_user:secure_password@localhost:5432/athleteiq_db"

# Node Environment
NODE_ENV=development

# Server Configuration
PORT=4000

# CORS Configuration
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# Firebase Admin SDK Configuration
# Download serviceAccountKey.json from Firebase Console -> Project Settings -> Service Accounts
# Or set FIREBASE_SERVICE_ACCOUNT_KEY environment variable with the JSON content
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}'

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="7d"

# Redis Configuration (required for job queue)
REDIS_URL="redis://localhost:6379"

# Google Cloud Storage Configuration (required for video storage)
GCS_BUCKET_NAME="athleteiq-videos"
GCS_PROJECT_ID="your-gcp-project-id"
# Optional: GOOGLE_CLOUD_CREDENTIALS - JSON credentials as string
# If not set, uses Application Default Credentials or Firebase service account

# Internal Service Authentication
# Token used by motion service to call internal endpoints
# Should be a long random string
INTERNAL_SERVICE_TOKEN="your-super-secret-internal-service-token"

# Gemini API Configuration (optional, for AI analysis)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL_VERSION="gemini-2.0-pro"

